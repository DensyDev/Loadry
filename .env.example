# Optional external API origin for a separately hosted frontend.
VITE_LOADRY_API_URL=

# Project configuration. Inline JSON takes precedence over the remote URL.
# Copy the contents of loadry.config.example.json onto one line for inline configuration.
LOADRY_CONFIG_JSON=
LOADRY_CONFIG_URL=

# Optional bearer token sent only when loading LOADRY_CONFIG_URL.
LOADRY_CONFIG_TOKEN=

# Remote configuration refresh interval. Defaults to 60 seconds.
LOADRY_CONFIG_CACHE_TTL_SECONDS=60

# Number of builds returned on each paginated versions page (1-1000).
LOADRY_VERSIONS_PAGE_SIZE=50

# Increment used by the page-size control. Must evenly divide the page size.
LOADRY_VERSIONS_PAGE_SIZE_STEP=5
