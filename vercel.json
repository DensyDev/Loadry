{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server?path=/api/:path*"
    },
    {
      "source": "/download/:path*",
      "destination": "/api/server?path=/download/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
