{
  "name": "@densy/loadry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @densy/loadry-contracts && npm run build --workspace @densy/loadry-sdk && npm run typecheck --workspace @densy/loadry-backend && npm run build --workspace @densy/loadry-frontend",
    "dev": "npm run dev --workspace @densy/loadry-frontend",
    "preview": "npm run preview --workspace @densy/loadry-frontend",
    "test": "npm run test --workspace @densy/loadry-sdk",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/densydev/loadry.git"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
