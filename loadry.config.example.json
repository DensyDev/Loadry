{
  "version": 1,
  "site": {
    "name": "Loadry",
    "title": {
      "en_US": "{project.name} — {site.name}"
    },
    "header": {
      "brand": "{project.name}",
      "url": "/"
    },
    "footer": {
      "enabled": true,
      "text": {
        "en_US": "Downloads powered by {site.name}"
      },
      "links": [
        {
          "label": "GitHub",
          "url": "https://github.com/DensyDev/Loadry",
          "icon": "github"
        }
      ]
    }
  },
  "projects": [
    {
      "id": "reposilite",
      "name": "Reposilite Example",
      "description": "Example of downloads from the Reposilite repository",
      "domains": [],
      "providers": [
        {
          "type": "reposilite",
          "id": "stable-releases",
          "label": "Stable / Releases",
          "branch": "stable",
          "branchLabel": "branches.stable",
          "showInAllBranches": true,
          "baseUrl": "https://repo.reposilite.com",
          "repository": "releases",
          "groupId": "com.reposilite",
          "artifactId": "reposilite"
        },
        {
          "type": "reposilite",
          "id": "dev-snapshots",
          "label": "Dev / Snapshots",
          "branch": "dev",
          "branchLabel": "branches.dev",
          "showInAllBranches": true,
          "baseUrl": "https://repo.reposilite.com",
          "repository": "snapshots",
          "groupId": "com.reposilite",
          "artifactId": "reposilite"
        }
      ]
    },
    {
      "id": "maven-jetbrains-annotations",
      "name": "Maven Jetbrains Annotations Example",
      "description": "Example of downloads from the Maven repository for the JetBrains Java Annotations package",
      "domains": [],
      "providers": [
        {
          "type": "maven",
          "id": "releases",
          "label": "Releases",
          "branch": "releases",
          "baseUrl": "https://repo1.maven.org/maven2",
          "groupId": "org.jetbrains",
          "artifactId": "annotations",
          "extension": "jar",
          "classifier": null
        }
      ]
    },
    {
      "id": "maven-google-guava",
      "name": "Maven Google Guava Example",
      "description": "Example of downloads from the Maven repository for the Google Guava package",
      "domains": [],
      "providers": [
        {
          "type": "maven",
          "id": "releases",
          "label": "Releases",
          "branch": "releases",
          "baseUrl": "https://repo1.maven.org/maven2",
          "groupId": "com.google.guava",
          "artifactId": "guava",
          "extension": "jar",
          "classifier": null
        }
      ]
    }
  ]
