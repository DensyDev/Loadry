{
  "version": 1,
  "site": {
    "name": "Loadry",
    "title": {
      "en_US": "{project.name} — {site.name}"
    },
    "header": {
      "brand": "{project.name}",
      "url": "/"
    },
    "footer": {
      "enabled": true,
      "text": {
        "en_US": "Downloads powered by {site.name}"
      },
      "links": [
        {
          "label": "GitHub",
          "url": "https://github.com/DensyDev/Loadry",
          "icon": "github"
        }
      ]
    }
  },
  "projects": [
    {
      "id": "reposilite",
      "name": "Reposilite Example",
      "description": "Example of downloads from the Reposilite repository",
      "domains": [],
      "tagGroups": [
        {
          "id": "release-kind",
          "label": "Release kind",
          "values": [
            { "id": "release", "label": "Release" },
            { "id": "snapshot", "label": "Snapshot" }
          ]
        }
      ],
      "providers": [
        {
          "type": "reposilite",
          "id": "releases",
          "label": "Releases",
          "branch": "releases",
          "branchLabel": "Releases",
          "showInAllBranches": true,
          "baseUrl": "https://repo.reposilite.com",
          "repository": "releases",
          "groupId": "com.reposilite",
          "artifactId": "reposilite",
          "tagResolvers": [
            {
              "group": "release-kind",
              "value": "release",
              "when": { "field": "branch.id", "operator": "equals", "value": "stable" }
            }
          ]
        },
        {
          "type": "reposilite",
          "id": "snapshots",
          "label": "Snapshots",
          "branch": "snapshots",
          "branchLabel": "Snapshots",
          "showInAllBranches": true,
          "baseUrl": "https://repo.reposilite.com",
          "repository": "snapshots",
          "groupId": "com.reposilite",
          "artifactId": "reposilite",
          "tagResolvers": [
            {
              "group": "release-kind",
              "value": "snapshot",
              "when": { "field": "logicalVersion", "operator": "endsWith", "value": "-SNAPSHOT" }
            }
          ]
        }
      ]
    },
    {
      "id": "maven-jetbrains-annotations",
      "name": "Maven Jetbrains Annotations Example",
      "description": "Example of downloads from the Maven repository for the JetBrains Java Annotations package",
      "domains": [],
      "providers": [
        {
          "type": "maven",
          "id": "releases",
          "label": "Releases",
          "branch": "releases",
          "baseUrl": "https://repo1.maven.org/maven2",
          "groupId": "org.jetbrains",
          "artifactId": "annotations",
          "extension": "jar",
          "classifier": null
        }
      ]
    },
    {
      "id": "maven-google-guava",
      "name": "Maven Google Guava Example",
      "description": "Example of downloads from the Maven repository for the Google Guava package",
      "domains": [],
      "tagGroups": [
        {
          "id": "variant",
          "label": "Variant",
          "values": [
            { "id": "jre", "label": "JRE" },
            { "id": "android", "label": "Android" }
          ]
        }
      ],
      "providers": [
        {
          "type": "maven",
          "id": "releases",
          "label": "Releases",
          "branch": "releases",
          "baseUrl": "https://repo1.maven.org/maven2",
          "groupId": "com.google.guava",
          "artifactId": "guava",
          "extension": "jar",
          "classifier": null,
          "tagResolvers": [
            {
              "group": "variant",
              "value": "jre",
              "when": { "field": "logicalVersion", "operator": "endsWith", "value": "-jre" }
            },
            {
              "group": "variant",
              "value": "android",
              "when": { "field": "logicalVersion", "operator": "endsWith", "value": "-android" }
            }
          ]
        }
      ]
    }
  ]
}
